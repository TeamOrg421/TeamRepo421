{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CarsAndBidsDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },

  "Jwt": {
    "Key": "MySuperSecretKey123456789123456789123",
    "Issuer": "CarAuctionAPI",
    "Audience": "CarAuctionClient",
    "ExpireMinutes": 60
  },
  "Pagination": {
    "DefaultPageSize": 10
  },
  "AzureBlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "car-images"
  }
}
